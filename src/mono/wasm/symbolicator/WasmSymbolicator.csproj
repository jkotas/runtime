<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- this DLL is loaded into xharness via reflection. 
         It could be running on machine with $(NetCoreAppMinimum) installed and it would be $(NetCoreAppMinimum) process.
         Because xharness is built for $(NetPrevious).
         That prevents dependencies from $(AspNetCoreAppCurrent) to be loaded -->
    <TargetFramework>$(NetCoreAppMinimum)</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CA1873</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.DotNet.XHarness.Common" Version="$(MicrosoftDotNetXHarnessTestRunnersCommonVersion)" />
    <!-- Update and drop package assets from Json, we'll use the framework version -->
    <PackageReference Include="System.Text.Json" Version="$(SystemTextJsonVersion)" PrivateAssets="All" ExcludeAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\data\wasm-symbol-patterns.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
